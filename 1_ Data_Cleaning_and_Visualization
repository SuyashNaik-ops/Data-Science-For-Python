# 1_ Data_Cleaning_and_Visualization
# ============================================================

# Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


# ------------------------------------------------------------
# 1. Load Dataset
# ------------------------------------------------------------

# Change the filename according to your dataset
df = pd.read_csv("raw_dataset.csv")

print("First 5 rows:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)


# ------------------------------------------------------------
# 2. Basic Dataset Information
# ------------------------------------------------------------

print("\nDataset Information:")
print(df.info())

print("\nStatistical Summary:")
print(df.describe())

print("\nColumn Names:")
print(df.columns)


# ------------------------------------------------------------
# 3. Check Missing Values
# ------------------------------------------------------------

print("\nMissing Values:")
print(df.isnull().sum())

# Missing-value percentage
missing_percentage = (df.isnull().sum() / len(df)) * 100

print("\nMissing Value Percentage:")
print(missing_percentage)


# ------------------------------------------------------------
# 4. Handle Missing Values
# ------------------------------------------------------------

# Fill numerical missing values with median
numeric_columns = df.select_dtypes(include=np.number).columns

for column in numeric_columns:
    df[column] = df[column].fillna(df[column].median())


# Fill categorical missing values with mode
categorical_columns = df.select_dtypes(include="object").columns

for column in categorical_columns:
    if df[column].isnull().sum() > 0:
        df[column] = df[column].fillna(df[column].mode()[0])


print("\nMissing Values After Cleaning:")
print(df.isnull().sum())


# ------------------------------------------------------------
# 5. Check and Remove Duplicate Rows
# ------------------------------------------------------------

print("\nNumber of Duplicate Rows:")
print(df.duplicated().sum())

df = df.drop_duplicates()

print("\nShape After Removing Duplicates:")
print(df.shape)


# ------------------------------------------------------------
# 6. Detect Outliers using IQR
# ------------------------------------------------------------

print("\nOutlier Detection:")

for column in numeric_columns:

    Q1 = df[column].quantile(0.25)
    Q3 = df[column].quantile(0.75)

    IQR = Q3 - Q1

    lower_limit = Q1 - 1.5 * IQR
    upper_limit = Q3 + 1.5 * IQR

    outliers = df[
        (df[column] < lower_limit) |
        (df[column] > upper_limit)
    ]

    print(column, ":", len(outliers), "outliers")


# ------------------------------------------------------------
# 7. Remove Outliers using IQR
# ------------------------------------------------------------

for column in numeric_columns:

    Q1 = df[column].quantile(0.25)
    Q3 = df[column].quantile(0.75)

    IQR = Q3 - Q1

    lower_limit = Q1 - 1.5 * IQR
    upper_limit = Q3 + 1.5 * IQR

    df = df[
        (df[column] >= lower_limit) &
        (df[column] <= upper_limit)
    ]


print("\nShape After Removing Outliers:")
print(df.shape)


# ------------------------------------------------------------
# 8. Final Cleaned Dataset
# ------------------------------------------------------------

print("\nCleaned Dataset:")
print(df.head())

print("\nFinal Dataset Information:")
print(df.info())


# ------------------------------------------------------------
# 9. Histogram
# ------------------------------------------------------------

# Select first numerical column
if len(numeric_columns) > 0:

    column = numeric_columns[0]

    plt.figure(figsize=(8, 5))

    sns.histplot(
        df[column],
        kde=True
    )

    plt.title("Distribution of " + column)
    plt.xlabel(column)
    plt.ylabel("Frequency")

    plt.show()


# ------------------------------------------------------------
# 10. Box Plot
# ------------------------------------------------------------

if len(numeric_columns) > 0:

    column = numeric_columns[0]

    plt.figure(figsize=(8, 5))

    sns.boxplot(
        x=df[column]
    )

    plt.title("Box Plot of " + column)
    plt.xlabel(column)

    plt.show()


# ------------------------------------------------------------
# 11. Correlation Heatmap
# ------------------------------------------------------------

if len(numeric_columns) > 1:

    plt.figure(figsize=(10, 6))

    correlation = df[numeric_columns].corr()

    sns.heatmap(
        correlation,
        annot=True,
        cmap="coolwarm",
        fmt=".2f"
    )

    plt.title("Correlation Heatmap")

    plt.show()


# ------------------------------------------------------------
# 12. Scatter Plot
# ------------------------------------------------------------

if len(numeric_columns) >= 2:

    x_column = numeric_columns[0]
    y_column = numeric_columns[1]

    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=df,
        x=x_column,
        y=y_column
    )

    plt.title(
        x_column + " vs " + y_column
    )

    plt.xlabel(x_column)
    plt.ylabel(y_column)

    plt.show()


# ------------------------------------------------------------
# 13. Bar Chart for Categorical Data
# ------------------------------------------------------------

if len(categorical_columns) > 0:

    column = categorical_columns[0]

    plt.figure(figsize=(10, 5))

    df[column].value_counts().head(10).plot(
        kind="bar"
    )

    plt.title("Top Categories in " + column)
    plt.xlabel(column)
    plt.ylabel("Count")

    plt.xticks(rotation=45)

    plt.show()


# ------------------------------------------------------------
# 14. Save Cleaned Dataset
# ------------------------------------------------------------

df.to_csv(
    "cleaned_dataset.csv",
    index=False
)

print("\nCleaned dataset saved as cleaned_dataset.csv")


# ------------------------------------------------------------
# 15. Final Summary
# ------------------------------------------------------------

print("\n========== PROJECT SUMMARY ==========")

print("Original dataset cleaned successfully.")
print("Missing values handled.")
print("Duplicate records removed.")
print("Outliers detected and removed.")
print("Data visualizations generated.")
print("Cleaned dataset exported successfully.")

print("====================================")
